FROM python:3.14-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy only tester runtime files
COPY cli.py ./cli.py
COPY test_contracts/app ./test_contracts/app

# Ensure executables are runnable
RUN chmod +x cli.py test_contracts/app/test_smart_contracts.py

# Tester runtime config
ENV API_BASE_URL="http://api:8000"
ENV SOLSIFT_BATCH_IN_CONTAINER="1"

# Batch tester image entrypoint
ENTRYPOINT ["python3.14", "test_contracts/app/test_smart_contracts.py"]
CMD ["--help"]
